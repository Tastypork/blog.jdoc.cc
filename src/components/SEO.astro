---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { SITE } from "../lib/site";
import defaultOg from "../assets/brand/og-default.png";

interface Props {
  title: string;
  description: string;
  /** Path beginning with "/" */
  path: string;
  type?: "website" | "article";
  image?: ImageMetadata;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  type = "website",
  image = defaultOg,
  imageAlt = `${SITE.name} — ${SITE.tagline}`,
  publishedTime,
  modifiedTime,
  noindex = false
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(path, site).toString();

const og = await getImage({
  src: image,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 82
});
const ogUrl = new URL(og.src, site).toString();

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: ogUrl,
        url: canonical,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        author: { "@type": "Person", name: SITE.author.name, url: SITE.author.url },
        publisher: { "@type": "Person", name: SITE.author.name, url: SITE.url },
        mainEntityOfPage: canonical,
        isPartOf: { "@type": "Blog", name: SITE.name, url: SITE.url }
      }
    : {
        "@context": "https://schema.org",
        "@type": "Blog",
        name: SITE.name,
        description: SITE.description,
        url: SITE.url,
        author: { "@type": "Person", name: SITE.author.name, url: SITE.author.url }
      };
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="author" content={SITE.author.name} />
<meta id="theme-color" name="theme-color" content={SITE.themeColor.light} />
<meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === "article" && <meta property="article:author" content={SITE.author.name} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="sitemap" href="/sitemap-index.xml" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
