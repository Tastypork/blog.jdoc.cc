---
import type { ImageMetadata } from "astro";
import SEO from "../components/SEO.astro";
import RunningHead from "../components/RunningHead.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  type?: "website" | "article";
  image?: ImageMetadata;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  back?: boolean;
  bodyClass?: string;
}

const { back = false, bodyClass = "", ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...seo} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <RunningHead back={back} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
